----- build gitutil.py / 응답 / gpt-5.4 -----
from __future__ import annotations

import subprocess

from .models import GitContext, GitError, NoChangesError


def run_git(args: list[str], cwd: str | None = None) -> str:
    command = ['git'] + args
    try:
        completed = subprocess.run(
            command,
            cwd=cwd,
            capture_output=True,
            text=True,
            encoding='utf-8',
            errors='replace',
            check=True,
        )
    except FileNotFoundError as exc:
        raise GitError('git 명령을 찾을 수 없습니다.', hint='Git이 설치되어 있는지 확인하세요.') from exc
    except subprocess.CalledProcessError as exc:
        stderr = (exc.stderr or '').strip()
        stdout = (exc.stdout or '').strip()
        message = stderr or stdout or 'git 명령 실행에 실패했습니다.'
        raise GitError(message) from exc
    return completed.stdout


def is_git_repo(cwd: str | None = None) -> bool:
    try:
        output = run_git(['rev-parse', '--is-inside-work-tree'], cwd=cwd).strip()
    except GitError:
        return False
    return output == 'true'


def collect_status(cwd: str | None = None) -> str:
    return run_git(['status', '--short'], cwd=cwd)


def collect_diff(cwd: str | None = None) -> str:
    return run_git(['diff'], cwd=cwd)


def current_branch(cwd: str | None = None) -> str:
    return run_git(['rev-parse', '--abbrev-ref', 'HEAD'], cwd=cwd).strip()


def parse_changed_files(status_text: str) -> list[str]:
    files: list[str] = []
    for raw_line in status_text.splitlines():
        line = raw_line.rstrip()
        if not line.strip():
            continue
        entry = line[3:] if len(line) >= 4 else line.strip()
        if ' -> ' in entry:
            entry = entry.split(' -> ', 1)[1]
        entry = entry.strip()
        if entry:
            files.append(entry)
    return files


def collect_context(cwd: str | None = None) -> GitContext:
    if not is_git_repo(cwd=cwd):
        raise GitError('Git 저장소가 아닙니다.', hint='Git이 초기화된 프로젝트 루트 디렉토리에서 실행하세요.')

    status_text = collect_status(cwd=cwd)
    diff_text = collect_diff(cwd=cwd)

    if not status_text.strip() and not diff_text.strip():
        raise NoChangesError()

    changed_files = parse_changed_files(status_text)
    branch = current_branch(cwd=cwd)
    diff_line_count = len(diff_text.splitlines())

    return GitContext(
        status=status_text,
        diff=diff_text,
        branch=branch,
        changed_files=changed_files,
        diff_line_count=diff_line_count,
    )
