----- build sanitize.py / 응답 / gpt-5.4 -----
import re


_EMAIL_PATTERN = re.compile(r'\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}\b')
_SK_TOKEN_PATTERN = re.compile(r'\bsk-[A-Za-z0-9._\-]{17,}\b')
_AI_API_KEY_PATTERN = re.compile(r'(AI_API_KEY\s*=\s*)([^\s\'"]+)')


def mask_secrets(text: str) -> str:
    text = _EMAIL_PATTERN.sub('[MASKED_EMAIL]', text)
    text = _SK_TOKEN_PATTERN.sub('[MASKED_KEY]', text)
    text = _AI_API_KEY_PATTERN.sub(r'\1[MASKED_KEY]', text)
    return text


def limit_diff(diff: str, max_files: int = 10, max_lines: int = 200) -> str:
    if not diff:
        return diff

    lines = diff.splitlines()
    limited_lines: list[str] = []
    file_count = 0
    in_file = False
    truncated_by_files = False
    truncated_by_lines = False

    for line in lines:
        if line.startswith('diff --git '):
            if file_count >= max_files:
                truncated_by_files = True
                break
            file_count += 1
            in_file = True

        if not in_file and file_count == 0:
            in_file = True

        if len(limited_lines) >= max_lines:
            truncated_by_lines = True
            break

        limited_lines.append(line)

    if len(lines) > len(limited_lines) and not truncated_by_files and len(limited_lines) >= max_lines:
        truncated_by_lines = True

    if truncated_by_files:
        limited_lines.append('')
        limited_lines.append(f'[TRUNCATED] 최대 {max_files}개 파일까지만 전송되었습니다.')
    elif truncated_by_lines:
        limited_lines.append('')
        limited_lines.append(f'[TRUNCATED] 최대 {max_lines}줄까지만 전송되었습니다.')

    return '\n'.join(limited_lines)


def apply_safe_mode(diff: str, enabled: bool) -> str:
    if not enabled:
        return diff
    return limit_diff(mask_secrets(diff), max_files=10, max_lines=200)
