from dataclasses import dataclass, field


@dataclass
class GitContext:
    status: str
    diff: str
    branch: str
    changed_files: list[str] = field(default_factory=list)
    diff_line_count: int = 0


@dataclass
class CommitMessage:
    title: str
    body_bullets: list[str] = field(default_factory=list)


@dataclass
class PullRequest:
    title: str
    why: list[str] = field(default_factory=list)
    what: list[str] = field(default_factory=list)
    how_to_test: list[str] = field(default_factory=list)


@dataclass
class GenerationConfig:
    model: str
    temperature: float
    max_tokens: int
    safe_mode: bool


class AppError(Exception):
    def __init__(self, message: str, hint: str | None = None):
        super().__init__(message)
        self.message: str = message
        self.hint: str | None = hint


class NoChangesError(AppError):
    def __init__(self, message: str = '변경 사항이 없습니다. 커밋 메시지를 생성하지 않고 종료합니다.'):
        super().__init__(message)


class GitError(AppError):
    def __init__(self, message: str, hint: str | None = None):
        super().__init__(message, hint)


class ApiKeyMissingError(AppError):
    def __init__(
        self,
        message: str = 'CODY_GPT_KEY 환경변수가 설정되지 않았습니다.',
        hint: str | None = 'export CODY_GPT_KEY="YOUR_KEY"',
    ):
        super().__init__(message, hint)


class ApiError(AppError):
    def __init__(self, message: str, hint: str | None = None):
        super().__init__(message, hint)
