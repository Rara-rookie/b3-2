----- build safety.py / 응답 / gpt-5.4 -----
import re

MAX_FILES: int = 10
MAX_LINES: int = 200

_EMAIL_RE = re.compile(r'\b[a-zA-Z0-9._%+\-]+@[a-zA-Z0-9.\-]+\.[A-Za-z]{2,}\b')
_SK_KEY_RE = re.compile(r'\bsk-[A-Za-z0-9._\-]+\b')
_DIFF_FILE_RE = re.compile(r'^diff --git a/(.*?) b/(.*?)$')


def mask_secrets(text: str) -> str:
    masked = _EMAIL_RE.sub('[MASKED]', text)
    masked = _SK_KEY_RE.sub('[MASKED]', masked)
    return masked


def limit_diff(diff_text: str, max_files: int = MAX_FILES, max_lines: int = MAX_LINES) -> str:
    if not diff_text:
        return diff_text

    lines = diff_text.splitlines()
    kept_lines: list[str] = []
    files_seen = 0
    in_file = False

    for line in lines:
        match = _DIFF_FILE_RE.match(line)
        if match:
            if files_seen >= max_files:
                break
            files_seen += 1
            in_file = True

        if not in_file and files_seen == 0:
            kept_lines.append(line)
        elif in_file:
            kept_lines.append(line)

        if len(kept_lines) >= max_lines:
            kept_lines = kept_lines[:max_lines]
            break

    return '\n'.join(kept_lines)


def sanitize(diff_text: str, safe_mode: bool) -> str:
    if not safe_mode:
        return diff_text
    return limit_diff(mask_secrets(diff_text))
