----- build formatter.py / 응답 / gpt-5.4 -----
def trim_commit_title(title: str, max_len: int = 72) -> str:
    return title.strip()[:max_len]


def trim_pr_title(title: str, max_len: int = 80) -> str:
    return title.strip()[:max_len]


def _normalize_lines(text: str) -> list[str]:
    return [line.rstrip() for line in text.replace("\r\n", "\n").replace("\r", "\n").split("\n")]


def _first_non_empty_line(lines: list[str]) -> str:
    for line in lines:
        if line.strip():
            return line.strip()
    return ""


def _remaining_after_first_non_empty(lines: list[str]) -> str:
    found = False
    remaining: list[str] = []
    for line in lines:
        if not found and line.strip():
            found = True
            continue
        if found:
            remaining.append(line)
    return "\n".join(remaining).strip()


def render_commit(raw: str) -> str:
    lines = _normalize_lines(raw)
    title = trim_commit_title(_first_non_empty_line(lines))
    body = _remaining_after_first_non_empty(lines)

    commit_text = title
    if body:
        commit_text = f"{title}\n\n{body}"

    return f"--- Commit Message ---\n{commit_text}\n----------------------"


def _extract_pr_title_and_body(raw: str) -> tuple[str, str]:
    lines = _normalize_lines(raw)

    title = ""
    body_lines: list[str] = []
    in_body = False

    for line in lines:
        stripped = line.strip()

        if stripped.lower() == "--- pr title ---":
            continue
        if stripped.lower() == "--- pr body ---":
            in_body = True
            continue

        if not title and stripped:
            title = stripped
            continue

        if in_body or stripped.startswith("## ") or title:
            body_lines.append(line)

    body = "\n".join(body_lines).strip()
    return trim_pr_title(title), body


def _has_bullet(section_lines: list[str]) -> bool:
    for line in section_lines:
        stripped = line.strip()
        if stripped.startswith("- ") or stripped.startswith("* "):
            return True
    return False


def ensure_pr_sections(body: str) -> str:
    lines = _normalize_lines(body)
    sections = {
        "Why": [],
        "What": [],
        "How to Test": [],
    }

    current: str | None = None
    for line in lines:
        stripped = line.strip()
        if stripped == "## Why":
            current = "Why"
            continue
        if stripped == "## What":
            current = "What"
            continue
        if stripped == "## How to Test":
            current = "How to Test"
            continue
        if current is not None:
            sections[current].append(line)

    rendered_sections: list[str] = []
    for name in ("Why", "What", "How to Test"):
        content_lines = [line for line in sections[name] if line.strip()]
        if not _has_bullet(content_lines):
            content_lines = ["- 내용 확인 필요"]
        rendered_sections.append(f"## {name}")
        rendered_sections.extend(content_lines)
        rendered_sections.append("")

    return "\n".join(rendered_sections).strip()


def render_pr(raw: str) -> str:
    title, body = _extract_pr_title_and_body(raw)
    body = ensure_pr_sections(body)

    return f"--- PR Title ---\n{title}\n--- PR Body ---\n{body}"
